# pecl-proxy settings. Every variable is optional; the value shown is the default.
# Full reference: docs/en/configuration.md (Russian: docs/ru/configuration.md)

# --- network -------------------------------------------------------------------------------
# External address of the proxy, used in channel.xml and download URLs. Strongly recommended:
# PEAR clients send the Host header without the port. Keep it on port 80/443.
PECL_PROXY_PUBLIC_URL=http://pecl-proxy.example.local
# PECL_PROXY_HOST=0.0.0.0
# PECL_PROXY_PORT=8080
# Reverse proxies allowed to set X-Forwarded-Proto/Host/Prefix/For and X-Real-IP
# (IPs/CIDRs, "private" = loopback + private ranges, "*" = any).
# nginx on the Docker host connects from the Docker network gateway (172.17.0.1, 172.18.0.1...),
# so use "private" there and publish the port on 127.0.0.1 only (see docker-compose.yml).
# PECL_PROXY_TRUSTED_PROXIES=127.0.0.1

# --- upstream ------------------------------------------------------------------------------
# PECL_PROXY_UPSTREAM_URL=https://pecl.php.net
# PECL_PROXY_UPSTREAM_CONNECT_TIMEOUT=5
# PECL_PROXY_UPSTREAM_READ_TIMEOUT=60
# PECL_PROXY_UPSTREAM_RETRIES=2
# PECL_PROXY_UPSTREAM_RETRY_DELAY=1
# PECL_PROXY_UPSTREAM_DOWN_COOLDOWN=30
# PECL_PROXY_OFFLINE=false
# PECL_PROXY_MAX_DOWNLOAD_SIZE=200MB
# Outgoing proxy for reaching pecl.php.net, if needed
# HTTPS_PROXY=http://proxy.example.local:3128

# --- channel -------------------------------------------------------------------------------
# PECL_PROXY_CHANNEL_SUMMARY=

# --- cache ---------------------------------------------------------------------------------
# PECL_PROXY_DATA_DIR=/data
# PECL_PROXY_METADATA_TTL=300
# PECL_PROXY_IMMUTABLE_RECHECK_EVERY=50
# PECL_PROXY_NEGATIVE_TTL=60

# --- landing page --------------------------------------------------------------------------
# PECL_PROXY_INDEX_ENABLED=true

# --- metrics -------------------------------------------------------------------------------
# PECL_PROXY_METRICS_ENABLED=true
# PECL_PROXY_METRICS_PATH=/metrics
# PECL_PROXY_METRICS_PORT=
# PECL_PROXY_METRICS_PREFIX=pecl_proxy

# --- admin API (disabled while the token is empty) ------------------------------------------
# PECL_PROXY_ADMIN_TOKEN=
# PECL_PROXY_ADMIN_PATH=/_admin

# --- logging (JSON) ------------------------------------------------------------------------
# PECL_PROXY_LOG_LEVEL=INFO
# PECL_PROXY_LOG_FILE=
# PECL_PROXY_ACCESS_LOG=true
